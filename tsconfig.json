{
  "compilerOptions": {
    "target": "ES2017",
  "module": "NodeNext",
  "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "skipLibCheck": true,
    "lib": ["ESNext"],
    "outDir": "dist/"
  },
  "include": ["src/**/*.ts"]
}
